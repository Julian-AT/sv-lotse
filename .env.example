# Copy to .env.local, or run orchestration/bin/setup, which fills it in.
# Generate each secret with: openssl rand -base64 48
OPENAI_API_KEY=
SESSION_SECRET=
APPROVAL_HMAC_SECRET=
CRON_SECRET=

# Local Postgres and MinIO from docker compose; these defaults work as they are.
# Deployed: Neon DATABASE_URL (?sslmode=require) and Cloudflare R2 (S3_REGION=auto).
DATABASE_URL=postgres://lotse:lotse@localhost:5432/lotse
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lotse
S3_ACCESS_KEY_ID=lotse
S3_SECRET_ACCESS_KEY=lotse-dev-secret
S3_FORCE_PATH_STYLE=true

# Voice, required from W1 (ElevenLabs Scribe and TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DE=
ELEVENLABS_VOICE_ID_EN=
