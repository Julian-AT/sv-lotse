# Copy to .env.local and fill in. Generate each secret with: openssl rand -base64 48

# Required from the start
OPENAI_API_KEY=
SESSION_SECRET=
APPROVAL_HMAC_SECRET=
CRON_SECRET=

# Local services from docker compose; these defaults work as they are
DATABASE_URL=postgres://lotse:lotse@localhost:5432/lotse
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=lotse
S3_ACCESS_KEY_ID=lotse
S3_SECRET_ACCESS_KEY=lotse-dev-secret
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# App
LOTSE_WORKSPACE_URL=http://localhost:3000
SVBOX_DIR=data/svbox

# OpenAI model per role; leave empty for the defaults in packages/brain/src/models
OPENAI_MODEL_ORCHESTRATOR=
OPENAI_MODEL_CLASSIFIER=
OPENAI_MODEL_EXTRACTOR=
OPENAI_MODEL_GUARD=
OPENAI_MODEL_EMBEDDING=

# Voice, required from W1 (ElevenLabs Scribe and TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DE=
ELEVENLABS_VOICE_ID_EN=

# Relatives mode, required from W4 (LiveKit Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: LLM tracing and product analytics
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Tests: RUN_LIVE=1 runs the live provider tests; BRAIN_ALLOW_STUBS=1 enables tool stubs during the build
RUN_LIVE=0
BRAIN_ALLOW_STUBS=
