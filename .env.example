# Copy to .env.local for local development. Deployed hosts inject the same variables at runtime.
# Uncommented lines are needed locally; commented lines are optional and show the code default.
# Never put real secrets in this file, and never expose server variables through NEXT_PUBLIC_*.

# --- Secrets (separate random values, at least 32 characters: openssl rand -base64 48) ---
# Signs the anonymous session cookie and derives the document-encryption key.
SESSION_SECRET=
# Signs server-side approval records for approval-gated tools.
APPROVAL_HMAC_SECRET=
# Bearer token the scheduler sends to /api/jobs/worker.
CRON_SECRET=

# --- Models (OpenAI, server side only) ---
# Conversations, extraction, guards, vision fallback and embeddings.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (gateway or local proxy) for all model roles.
# OPENAI_BASE_URL=
# Optional separate endpoint/key for embeddings; default to the values above. Without working
# embeddings, ingestion and retrieval continue with German full-text search only.
# OPENAI_EMBEDDING_BASE_URL=
# OPENAI_EMBEDDING_API_KEY=
# Set to false when the endpoint does not persist response items (default false with
# OPENAI_BASE_URL); reasoning is then sent inline.
# OPENAI_RESPONSES_STORE=
# Per-role model overrides; each role also accepts a *_FALLBACK model.
# OPENAI_MODEL_ORCHESTRATOR=gpt-5.4-mini
# OPENAI_MODEL_ORCHESTRATOR_FALLBACK=
# OPENAI_MODEL_CLASSIFIER=gpt-5.4-nano
# OPENAI_MODEL_CLASSIFIER_FALLBACK=
# OPENAI_MODEL_GUARD=gpt-5.4-mini
# OPENAI_MODEL_GUARD_FALLBACK=
# OPENAI_MODEL_EXTRACTOR=gpt-5.4-mini
# OPENAI_MODEL_EXTRACTOR_FALLBACK=
# OPENAI_MODEL_VISION=gpt-5.4-mini
# OPENAI_MODEL_VISION_FALLBACK=
# OPENAI_MODEL_EMBEDDING=text-embedding-3-small
# OPENAI_MODEL_EMBEDDING_FALLBACK=
# Older name for OPENAI_MODEL_EMBEDDING; used only when that is unset.
# EMBEDDING_MODEL=
# Vision model for field detection on flat (scanned) PDF forms.
# FORM_VISION_MODEL=gpt-4.1-mini
# Per-case model spend in USD after which the orchestrator uses its fallback model; unset: no budget.
# LOTSE_CASE_BUDGET_USD=
# JSON map of model name to USD per million tokens {input, cachedInput, output}; defaults built in.
# LOTSE_MODEL_PRICING_JSON=

# --- Postgres (pgvector) and S3-compatible storage; defaults match docker compose ---
DATABASE_URL=postgres://lotse:lotse@localhost:5432/lotse
# Connection pool size per server process (1-100).
# DATABASE_POOL_SIZE=10
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lotse
S3_ACCESS_KEY_ID=lotse
S3_SECRET_ACCESS_KEY=lotse-dev-secret
# Path-style bucket URLs (needed for MinIO).
S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket.
# S3_PREFIX=

# --- Relatives mode (LiveKit); defaults match the local --dev server from docker compose ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Voice (ElevenLabs Scribe and TTS); the brain mints single-use client tokens ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DE=
ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- Web server ---
# Exact public origin of the workspace (also the only origin allowed to use the Mac bridge).
# LOTSE_WORKSPACE_URL=http://localhost:3000
# Folder with the original SV-Box challenge files, relative to the repository root or absolute.
# The container image defaults to /data/svbox.
# SVBOX_DIR=data/svbox
# Set by scripts and the container; listed for completeness.
# NODE_ENV=development
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Telemetry (off unless configured) ---
# Langfuse LLM traces; set both keys or neither.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# PostHog product events (server side, consent-based).
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Mac app (set in the app's launch environment, not on the web server) ---
# LOTSE_WORKSPACE_URL=http://localhost:3000
# Comma-separated bundle IDs of sensitive apps (banking, password managers) excluded from capture.
# LOTSE_CAPTURE_EXCLUDED_BUNDLE_IDS=
# Optional PostHog analytics for the native app; HTTPS host plus project token.
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_PROJECT_TOKEN=

# --- Evaluations and tests ---
# Set to 1 to run tests and evaluations that call paid providers.
# RUN_LIVE=1
# Judge and simulated-persona models for the evaluation suites.
# EVAL_JUDGE_MODEL=gpt-4.1-mini
# EVAL_PERSONA_MODEL=gpt-4.1-mini
# Port of the web server for Playwright suites (PW_TEST_PORT is read as a fallback).
# LOTSE_E2E_PORT=3000
# PW_TEST_PORT=
# Remote Playwright server, when the local browser cannot launch.
# PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3002/
# PW_TEST_CONNECT_EXPOSE_NETWORK=<loopback>
# Base URL for the source-page Playwright checks.
# SOURCE_TEST_URL=http://localhost:4343
# CI only: the commit checker's allowed author e-mail (a GitHub repository variable).
# ALLOWED_AUTHOR_EMAIL=

# --- Research (ml/ and paper/; not used by the product) ---
# IBM Quantum token for Qiskit Runtime experiments.
# IBM_QUANTUM_TOKEN=
# Hugging Face token and user name for model and dataset uploads.
# HF_TOKEN=
# HF_USERNAME=

# Set by the platform; never set by hand: NEXT_RUNTIME, NEXT_PHASE, GITHUB_ENV.
