# Defaults for orchestration/bin/wp. Override in .orchestration/config.local.env or the environment.

: "${CODEX_BIN:=codex}"
: "${CODEX_MODEL:=gpt-6.1-sol}"
: "${CODEX_EFFORT:=xhigh}"
: "${CODEX_ADD_DIRS:=}"

: "${MAX_PARALLEL:=16}"
: "${MAX_ATTEMPTS:=3}"

: "${BASE_BRANCH:=main}"
: "${REMOTE:=origin}"
: "${USE_GH:=1}"
: "${REQUIRE_CI:=auto}"
: "${CI_CHECK_NAME:=ci-ok}"

: "${GLOBAL_GATES:=[ ! -f turbo.json ] || pnpm -s verify}"
: "${GLOBAL_FORBIDDEN:=docs/prd/* docs/svbox-inventory.md data/svbox/* docs/challenge/* orchestration/* ORCHESTRATION.md CLAUDE.md AGENTS.md .claude/* .husky/* commitlint.config.mjs .orchestration/* .gitignore .gitattributes KI-Challenge_UseCase.yaml}"
: "${COMMIT_GATE:=}"

: "${DB_PER_WP:=1}"
: "${PG_SUPERUSER:=lotse}"
