# Pipeline configuration, sourced by orchestration/bin/wp.
# Every value uses ': "${VAR:=default}"', so an environment variable or
# .orchestration/config.local.env (git-ignored, sourced first) overrides it.

# --- Codex workers -----------------------------------------------------------
# Model id of GPT 6.1 Sol as your Codex CLI names it (check 'codex --help' or
# the model picker in the Codex TUI). Empty = Codex default model.
: "${CODEX_MODEL:=}"
# Reasoning effort for workers: low | medium | high | xhigh
: "${CODEX_EFFORT:=high}"
# Extra writable directories for the worker sandbox, colon-separated.
# Defaults cover the pnpm store and tool caches on macOS (set in wp if empty).
: "${CODEX_ADD_DIRS:=}"
: "${CODEX_BIN:=codex}"

# --- Parallelism and retries ------------------------------------------------
: "${MAX_PARALLEL:=8}"
# Attempts per work package (1 initial run + reworks) before escalation.
: "${MAX_ATTEMPTS:=3}"

# --- Git and GitHub ------------------------------------------------------------
: "${BASE_BRANCH:=main}"
: "${REMOTE:=origin}"
# 1 = open a GitHub PR per work package with gh; 0 = local fast-forward only.
: "${USE_GH:=1}"
# auto = wait for required checks once .github/workflows/ci.yml exists on main.
: "${REQUIRE_CI:=auto}"
# Name of the single required status check (the aggregate CI job).
: "${CI_CHECK_NAME:=ci-ok}"

# --- Verification ------------------------------------------------------------
# Gates run for every work package in addition to the brief's gates.
# Separate several gates with ';;'.
: "${GLOBAL_GATES:=[ ! -f package.json ] || pnpm -s verify}"
# Paths workers never change unless their brief owns them explicitly.
: "${GLOBAL_FORBIDDEN:=docs/prd/* orchestration/* ORCHESTRATION.md CLAUDE.md AGENTS.md .claude/* .githooks/* .orchestration/* .gitignore}"
# Optional gate run on every commit of a multi-commit branch during 'wp pr'.
: "${COMMIT_GATE:=}"

# --- Local services ------------------------------------------------------------
# Create one Postgres database per work package (needs 'docker compose up -d db').
: "${DB_PER_WP:=1}"
: "${PG_SUPERUSER:=lotse}"
