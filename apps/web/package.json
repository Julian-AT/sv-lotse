{
  "name": "@lotse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:guide && node scripts/run-next.mjs dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config vitest.config.ts --project unit",
    "test:services": "vitest run --config vitest.config.ts --project services",
    "build": "bun run build:guide && node scripts/run-next.mjs build && bun run build:migrator && node scripts/check-client-env.mjs",
    "start": "node scripts/start-standalone.mjs",
    "e2e": "playwright test",
    "e2e:relatives": "node --experimental-strip-types scripts/relatives-e2e.mjs",
    "test:integration": "bun run test:services && bun run e2e --grep @smoke",
    "build:migrator": "bun scripts/build-migrator.mjs",
    "test:workspace": "node --experimental-strip-types scripts/test-workspace.mjs",
    "test:controls": "node --experimental-transform-types scripts/test-controls.mjs",
    "build:guide": "bun run --filter @lotse/guide build:bundle",
    "e2e:form-stream": "node --experimental-strip-types scripts/test-form-stream.mjs",
    "e2e:workspace": "playwright test --config playwright.workspace.config.ts",
    "e2e:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.163",
    "@ai-sdk/react": "^4.0.167",
    "@elevenlabs/client": "^1.35.0",
    "@langfuse/otel": "^6.1.1",
    "@lotse/brain": "workspace:*",
    "@lotse/db": "workspace:*",
    "@lotse/guide": "workspace:*",
    "@lotse/knowledge": "workspace:*",
    "@lotse/protocol": "workspace:*",
    "@lotse/ui": "workspace:*",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "ai": "^7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "1.69.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "4.3.4"
  }
}
