email="$(git config user.email)"
author="$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<(.*)>.*/\1/')"
committer="$(git var GIT_COMMITTER_IDENT | sed -E 's/.*<(.*)>.*/\1/')"
if [ -z "$email" ] || [ "$author" != "$email" ] || [ "$committer" != "$email" ]; then
  echo "pre-commit: author and committer must be $email" >&2
  exit 1
fi
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)' | grep -vq '\.env\.example$'; then
  echo "pre-commit: refusing to commit env files" >&2
  exit 1
fi
if printf '%s\n' "$staged" | grep -q '^\.orchestration/'; then
  echo "pre-commit: .orchestration/ is local pipeline state" >&2
  exit 1
fi
