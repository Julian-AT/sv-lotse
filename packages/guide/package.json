    "test:bundle": "bun run build:bundle && node --experimental-strip-types test/run-e2e.ts bundle.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@lotse/protocol": "workspace:*",
    "@lotse/ui": "workspace:*",
    "zod": "^4"
  }
}
