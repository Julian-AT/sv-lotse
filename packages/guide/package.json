{
  "name": "@lotse/guide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./portal": "./src/portal-contract.ts",
    "./bundle": "./dist-bundle/guide.iife.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "e2e": "node --experimental-strip-types test/run-e2e.ts",
