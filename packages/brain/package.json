{
  "name": "@lotse/brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/client.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./db/approvals": "./src/db/approvals.ts",
    "./db/migrations": "./src/db/migrations.ts",
    "./storage/s3": "./src/storage/s3.ts",
    "./forms/detect": "./src/forms/detect/index.ts",
    "./deadlines": "./src/deadlines/index.ts",
    "./subjects": "./src/subjects/index.ts",
    "./language": "./src/language/index.ts",
    "./case-file": "./src/case-file/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./workspace": "./src/workspace/index.ts",
    "./workspace/schema": "./src/workspace/schema.ts",
    "./workspace/targets": "./src/workspace/targets.ts",
    "./resolve": "./src/resolve/index.ts",
    "./autonomy": "./src/autonomy/index.ts",
    "./autonomy/schema": "./src/autonomy/schema.ts",
    "./jobs": "./src/jobs/index.ts",
    "./conversation": "./src/conversation/continuity.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./forms/viewer": "./src/forms/viewer/index.ts",
    "./forms/viewer/schema": "./src/forms/viewer/schema.ts",
    "./voice": "./src/voice/index.ts",
    "./documents": "./src/documents/index.ts",
    "./relatives": "./src/relatives/index.ts",
    "./guards": "./src/guards/index.ts",
    "./config": "./src/config/index.ts",
    "./forms": "./src/forms/index.ts",
    "./forms/registry/schema": "./src/forms/registry/schema.ts",
    "./preferences": "./src/preferences/index.ts",
    "./preferences/schema": "./src/preferences/schema.ts",
    "./retrieval": "./src/retrieval/index.ts",
    "./engine": "./src/engine/index.ts"
  },
  "scripts": {
    "test:autonomy:integration": "vitest run test/autonomy/settings.db.test.ts test/autonomy/controls.db.test.ts test/autonomy/portal-fill.db.test.ts --hookTimeout=30000 --testTimeout=15000",
    "test:continuity:integration": "vitest run test/jobs/runner.db.test.ts test/runtime/continuity.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'test/**/*.db.test.ts' --exclude 'test/**/*.live.test.ts'",
    "test:live": "node test/runtime/live.mjs",
    "test:engine:integration": "vitest run test/engine/tools.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "test:directory:integration": "vitest run test/directory/tools.db.test.ts --hookTimeout=30000 --testTimeout=15000",
    "test:subjects": "vitest run test/subjects --hookTimeout=30000 --testTimeout=15000",
    "test:case-file": "vitest run test/case-file --hookTimeout=30000 --testTimeout=15000",
    "test:db": "bun run --filter @lotse/db test:db",
    "test:integration": "bun run --filter @lotse/db test:integration && vitest run test/pipeline/retrieval.db.test.ts test/pipeline/context.db.test.ts test/pipeline/goal.db.test.ts test/runtime/turn.db.test.ts test/runtime/persistence.db.test.ts test/runtime/continuity.db.test.ts test/jobs/runner.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "db:generate": "bun run --filter @lotse/db db:generate",
    "db:migrate": "bun run --filter @lotse/db db:migrate",
    "test:deadlines:integration": "vitest run test/deadlines/persistence.db.test.ts test/deadlines/service.db.test.ts --hookTimeout=30000 --testTimeout=15000",
    "test:language:integration": "vitest run test/language/profile.db.test.ts test/runtime/turn.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "test:catalog:integration": "vitest run test/catalog/catalog.db.test.ts --hookTimeout=30000 --testTimeout=15000",
    "test:telemetry:integration": "vitest run test/telemetry/persistence.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "test:documents:integration": "vitest run test/documents/service.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "test:forms:integration": "vitest run test/forms/runtime/forms.db.test.ts test/forms/runtime/review.db.test.ts --hookTimeout=30000 --testTimeout=30000",
    "test:workspace": "vitest run test/workspace --hookTimeout=30000 --testTimeout=30000"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.109",
    "@lotse/db": "workspace:*",
    "@lotse/knowledge": "workspace:*",
    "@lotse/protocol": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7",
    "canonicalize": "^5.1.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "livekit-server-sdk": "^2.19.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "yaml": "^2.9.1",
    "zod": "^4"
  }
}
