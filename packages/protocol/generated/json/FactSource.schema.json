{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "width": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "documentId": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "document",
        "statement"
      ],
      "type": "string"
    },
    "page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "quote": {
      "type": "string"
    },
    "turnId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "type": "object"
}
