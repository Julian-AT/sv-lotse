{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvalId": {
      "minLength": 1,
      "type": "string"
    },
    "caseId": {
      "minLength": 1,
      "type": "string"
    },
    "inputHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "provenance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "factId": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "bbox": {
                "additionalProperties": false,
                "properties": {
                  "height": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "width": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "x": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "y": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "type": "object"
              },
              "documentId": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "document",
                  "statement"
                ],
                "type": "string"
              },
              "page": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "quote": {
                "type": "string"
              },
              "turnId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "toolCallId": {
      "minLength": 1,
      "type": "string"
    },
    "toolName": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "approvalId",
    "caseId",
    "toolCallId",
    "toolName",
    "inputHash",
    "provenance",
    "summary"
  ],
  "type": "object"
}
