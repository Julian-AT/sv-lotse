{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appVersion": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "ocr": {
          "type": "boolean"
        },
        "onDeviceContextSize": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "onDeviceModel": {
          "type": "boolean"
        },
        "overlay": {
          "type": "boolean"
        }
      },
      "required": [
        "overlay",
        "accessibility",
        "ocr",
        "onDeviceModel",
        "onDeviceContextSize"
      ],
      "type": "object"
    },
    "clientKind": {
      "enum": [
        "web",
        "mac",
        "helper"
      ],
      "type": "string"
    },
    "locale": {
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "protocolVersion": {
      "const": "1.0.0",
      "type": "string"
    }
  },
  "required": [
    "clientKind",
    "appVersion",
    "protocolVersion",
    "capabilities",
    "locale"
  ],
  "type": "object"
}
