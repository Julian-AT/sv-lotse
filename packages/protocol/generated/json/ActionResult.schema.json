{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionId": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "failureReason": {
      "type": "string"
    },
    "resolvedBy": {
      "enum": [
        "ui",
        "dom",
        "ax",
        "ocr",
        "vision"
      ],
      "type": "string"
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "actionId",
    "resolvedBy",
    "confidence",
    "success"
  ],
  "type": "object"
}
