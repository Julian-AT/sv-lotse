{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "rect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 0,
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "scale": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "targetId": {
      "minLength": 1,
      "type": "string"
    },
    "visible": {
      "type": "boolean"
    }
  },
  "required": [
    "targetId",
    "rect",
    "scale",
    "visible"
  ],
  "type": "object"
}
